FROM python:3.11-slim

# Non-root user. uid 10001 sits outside the Debian default range (1000-1999,
# which can overlap a real host account through a bind mount) and away from
# 65534/nobody.
ARG UID=10001
RUN groupadd --system --gid ${UID} naso \
 && useradd --system --uid ${UID} --gid naso --home /app --shell /sbin/nologin naso

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
 && rm -rf /var/lib/apt/lists/*

# Set to "true" to also install the test and lint tooling. docker-compose.yml
# does this, because cli/validate.sh runs the suite inside the container.
# A production build should leave it at the default.
ARG INSTALL_DEV=false

# Dependencies are installed as root: pip needs write access to site-packages.
# The --trusted-host flags that used to be here are gone on purpose — they
# disable certificate verification for PyPI, which is not a trade this project
# should be making.
COPY backend/requirements.txt ./requirements.txt
COPY backend/requirements-dev.txt ./requirements-dev.txt
COPY shared/requirements-shared.txt ./shared/requirements-shared.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && if [ "$INSTALL_DEV" = "true" ]; then \
         pip install --no-cache-dir -r requirements-dev.txt; \
       fi

# The build toolchain that ships in python:3.11-slim carries fixable HIGH
# advisories of its own -- CVE-2026-24049 in wheel, CVE-2026-23949 in
# jaraco.context, CVE-2025-47273 in setuptools. None is an application
# dependency; they are here only because the image was built with pip.
#
# Explicit floors, and deliberately NOT `--upgrade pip`. The first attempt at
# this asked pip to upgrade itself and to install jaraco.context alongside
# setuptools; that made the resolver backtrack setuptools to 70.3.0 to keep a
# standalone jaraco.context installable, and swapped two advisories for two
# different ones. Modern setuptools vendors jaraco.context rather than
# depending on it, so the stale distribution is removed instead of upgraded.
#
# After the requirements install, deliberately: doing it before lets the
# requirements resolution walk a version back.
#
# The `<82` ceiling is load-bearing and must not be raised casually.
# setuptools 82 removed `pkg_resources`, and playwright-stealth 1.x imports it
# at module scope -- so shared/utils/stealth_browser.py raised
# ModuleNotFoundError, shared/tasks/darkweb.py failed to import, and both the
# worker and the API crash-looped. 78.1.1 is where CVE-2025-47273 is fixed and
# 81 is the last release that still ships pkg_resources, so this range patches
# the advisory and keeps the application importable. Verified per version, not
# assumed.
#
# Raising the ceiling requires migrating stealth_browser.py to
# playwright-stealth 2.x first; that migration is already on the backlog.
RUN pip install --no-cache-dir --upgrade \
        "setuptools>=78.1.1,<82" "wheel>=0.46.2" \
 && (pip uninstall -y jaraco.context || true)

# ensurepip's bundled wheels are an offline copy of pip/setuptools/wheel, kept
# so `python -m ensurepip` can work without a network. Nothing in these
# containers creates a virtualenv, so they are never installed and never
# execute -- but they are still scannable artifacts carrying whatever versions
# the base image froze. Removing them is free.
RUN rm -rf /usr/local/lib/python3.11/ensurepip

# NOTE: the durable fix for this whole class is a multi-stage build that leaves
# build-essential and the install toolchain behind in the builder stage, so the
# runtime image contains the application and nothing that built it. That is a
# larger change than this pass and is tracked separately.

COPY backend/ ./
COPY shared/ ./shared/
RUN chown -R naso:naso /app

# naso's home is /app, which docker-compose mounts read_only. Libraries that
# drop a dotfile in $HOME would fail on that, so point HOME at the /tmp tmpfs,
# the one writable path the container has.
ENV HOME=/tmp
USER naso:naso

# /system/status is unauthenticated and touches the database, so it is a real
# readiness signal rather than a liveness ping. Uses urllib because the slim
# image ships no curl, and 127.0.0.1 because TrustedHostMiddleware allows it.
#
# The body has to be parsed: the endpoint deliberately answers 200 with
# {"status": "degraded"} when the database probe fails, so checking the status
# line alone would report a container with a dead database as healthy.
HEALTHCHECK --interval=10s --timeout=5s --start-period=40s --retries=6 \
    CMD python -c "import json,sys,urllib.request; r=urllib.request.urlopen('http://127.0.0.1:8000/system/status', timeout=4); sys.exit(0 if r.status == 200 and json.load(r).get('status') == 'operational' else 1)"

# read_only: true in docker-compose blocks writes to /app; /tmp is a tmpfs.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
