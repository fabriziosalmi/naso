# NASO Forensic Engine — Environment Variables Reference
# Copy this file to `.env` and fill in EVERY value before deploying.
# Never commit the `.env` file — it is already in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=naso_admin
DB_PASSWORD=CHANGE_ME
DB_NAME=naso_db
DATABASE_URL=postgresql+asyncpg://naso_admin:CHANGE_ME@db:5432/naso_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── JWT Auth (EdDSA) ──────────────────────────────────────────────────────────
# Generate with: python cli/generate_secrets.py
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY must be the EdDSA key pair in PEM format.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ALGORITHM=EdDSA
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Secure cookie (set to true in production, behind HTTPS)
NASO_COOKIE_SECURE=false

# ── Redis (JWT Blacklist) ─────────────────────────────────────────────────────
REDIS_HOST=redis://naso-cache:6379/0

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# ELASTIC_PASSWORD is used by docker-compose, ES_PASSWORD by config.py
ELASTIC_PASSWORD=CHANGE_ME
ES_PASSWORD=CHANGE_ME
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic

# ── RabbitMQ (Celery Broker) ──────────────────────────────────────────────────
# REQUIRED — the system will not start without these values
RABBIT_USER=naso_broker_admin
RABBIT_PASSWORD=CHANGE_ME
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=naso_broker_admin
RABBITMQ_PASS=CHANGE_ME

# ── MinIO (Object Storage — Screenshot, PDF) ──────────────────────────────────
# REQUIRED — the system will not start without these values
MINIO_ROOT_USER=naso_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=naso_storage_admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Sentry (Opzionale) ───────────────────────────────────────────────────────
# Leave empty to disable Sentry entirely
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
ENVIRONMENT=production

# ── OpenTelemetry (Jaeger) ────────────────────────────────────────────────────
OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# ── AI Co-Analyst (LM Studio / Ollama) ───────────────────────────────────────
# In Docker usa host.docker.internal:1234, in locale usa localhost:1234
AI_ENDPOINT=http://host.docker.internal:1234/v1
AI_MODEL=gemma-4-e2b-it
AI_ENABLE_THINKING=false

# ── Shodan OSINT ─────────────────────────────────────────────────────────────
SHODAN_API_KEY=

# ── GitHub Intelligence ───────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Telegram Intelligence ────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=naso_forensic_bot

# ── SMTP / Notifiche ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.naso.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=naso-engine@naso.local
ENABLE_NOTIFICATIONS=true

# ── Webhook Signing (Outgoing Alerts) ─────────────────────────────────────────
# HMAC-SHA256 secret used to sign alerts sent to Slack/Discord/Teams (G-12).
# The receiver verifies X-Naso-Signature-256 against this secret.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NASO_WEBHOOK_SIGNING_SECRET=CHANGE_ME

# ── Report Forense — Firma Digitale ──────────────────────────────────────────
# Absolute path to the RSA PEM private key used to sign forensic dossiers.
# WARNING: the file MUST have 0o400 permissions (owner read only).
# chmod 400 /path/to/naso_forensic_signing.pem
NASO_PRIVATE_KEY_PATH=/run/secrets/naso_forensic_signing.pem

# ── Tor / Dark Web Proxy ──────────────────────────────────────────────────────
TOR_PROXY=socks5h://naso-tor-lb:8118


# MinIO Object Storage
# MINIO_ROOT_USER/PASSWORD used by docker-compose, MINIO_ACCESS/SECRET_KEY by config.py
MINIO_ROOT_USER=naso_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ACCESS_KEY=naso_storage_admin
MINIO_SECRET_KEY=CHANGE_ME

# OpenTelemetry (Jaeger)
OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# Local AI (LM Studio / Ollama)
AI_ENDPOINT=http://host.docker.internal:1234/v1
AI_MODEL=gemma-4-e2b-it

# JWT Secret (generate a strong random string)
SECRET_KEY=CHANGE_ME

# SMTP (optional — leave blank to disable email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=naso@example.com

# Telegram Intelligence (optional)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
