# NASO Forensic Engine — environment variables reference
#
# Copy this file to `.env` and replace every CHANGE_ME before deploying.
# Never commit the `.env` file — it is already in .gitignore.
#
# Two conventions live side by side and are easy to confuse:
#   * Variables read by docker-compose.yml to provision a service
#     (DB_USER, ELASTIC_PASSWORD, RABBIT_USER, MINIO_ROOT_USER, ...).
#   * Variables read by the application through shared/config.py
#     (DATABASE_URL, ES_PASSWORD, RABBITMQ_USER, MINIO_ACCESS_KEY, ...).
# Where both exist for one service they must agree, and the pairing is noted.
#
# Everything below is optional unless marked REQUIRED.

# ══ Database ═════════════════════════════════════════════════════════════════
# DB_USER / DB_PASSWORD / DB_NAME provision the Postgres container.
# DATABASE_URL is what the application connects with — keep them consistent.
DB_USER=naso_admin
DB_PASSWORD=CHANGE_ME
DB_NAME=naso_db
DATABASE_URL=postgresql+asyncpg://naso_admin:CHANGE_ME@db:5432/naso_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ══ Initial admin account ════════════════════════════════════════════════════
# Consumed by `docker exec naso-api python init_db.py`.
# NASO_ADMIN_PASSWORD is REQUIRED on first run — init_db.py refuses to
# provision an admin without it.
# Do NOT use a `.local`, `.test`, `.localhost`, `.invalid`, `.arpa` or `.onion`
# address: those are special-use TLDs and the API's EmailStr validation
# rejects them, so /users/me would fail for that account.
NASO_ADMIN_EMAIL=admin@naso.example.com
NASO_ADMIN_PASSWORD=CHANGE_ME

# ══ JWT auth (EdDSA) ═════════════════════════════════════════════════════════
# Generate with: python cli/generate_secrets.py
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY must be the Ed25519 key pair in PEM form.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ALGORITHM=EdDSA
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to true in production, where the API is served over HTTPS.
NASO_COOKIE_SECURE=false

# ══ Redis (JWT blacklist) ════════════════════════════════════════════════════
# Despite the name, this is a full connection URL.
REDIS_HOST=redis://naso-cache:6379/0

# ══ Elasticsearch ════════════════════════════════════════════════════════════
# ELASTIC_PASSWORD provisions the container; ES_PASSWORD is what the app uses.
ELASTIC_PASSWORD=CHANGE_ME
ES_PASSWORD=CHANGE_ME
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic

# ══ RabbitMQ (Celery broker) ═════════════════════════════════════════════════
# RABBIT_* provision the container; RABBITMQ_* are what the app uses.
# REQUIRED: a worker refuses to start without RABBITMQ_USER and RABBITMQ_PASS.
RABBIT_USER=naso_broker_admin
RABBIT_PASSWORD=CHANGE_ME
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=naso_broker_admin
RABBITMQ_PASS=CHANGE_ME

# ══ MinIO (object storage — screenshots, PDFs) ═══════════════════════════════
# MINIO_ROOT_* provision the container; MINIO_ACCESS_KEY / MINIO_SECRET_KEY are
# what the app uses. Storage is skipped entirely when the app pair is unset.
MINIO_ROOT_USER=naso_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=naso_storage_admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false

# ══ API security ═════════════════════════════════════════════════════════════
# Comma-separated. Must list the real frontend origin in production.
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ══ AI co-analyst (LM Studio / Ollama, OpenAI-compatible) ════════════════════
# From inside Docker use host.docker.internal; running on the host, localhost.
AI_ENDPOINT=http://host.docker.internal:1234/v1
AI_MODEL=gemma-4-e2b-it
AI_ENABLE_THINKING=false

# ══ Observability ════════════════════════════════════════════════════════════
# Tracing is opt-in. With it off no OTLP exporter is installed at all — an
# exporter with nothing listening on OTLP_ENDPOINT blocks process shutdown.
NASO_OTEL_ENABLED=true
OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# Leave SENTRY_DSN empty to disable Sentry entirely.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
ENVIRONMENT=production

# ══ OSINT sources (all optional — each feature is skipped when unset) ════════
SHODAN_API_KEY=
GITHUB_TOKEN=
PASTEBIN_API_KEY=

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=naso_forensic_bot

# ══ Tor / dark web ═══════════════════════════════════════════════════════════
TOR_PROXY=socks5h://naso-tor-lb:8118
# The NASO_DARKWEB_* family overrides shared/domain/services/dark_web/config.py.
# Safety bounds are enforced in code and cannot be widened from here
# (max_pages is capped at 20, retry_max_delay at 60s).
# NASO_DARKWEB_TOR_PROXY=socks5h://naso-tor-lb:8118
# NASO_DARKWEB_AHMIA_URL=
# NASO_DARKWEB_USER_AGENT=
# NASO_DARKWEB_MAX_PAGES=
# Comma-separated Tor control ports used for NEWNYM circuit rotation.
# NASO_DARKWEB_TOR_CONTROL_HOSTS=naso-tor-1,naso-tor-2,naso-tor-3
# NASO_DARKWEB_TOR_CONTROL_PASSWORD=
# Requires `stem`, already in the worker image.
# NASO_DARKWEB_ROTATE_CIRCUIT=false

# ══ SOAR / outbound alerting ═════════════════════════════════════════════════
# Fired for findings with severity_score >= 80. Leave empty to disable.
SOAR_WEBHOOK_URL=
# HMAC-SHA256 secret signing alerts to Slack/Discord/Teams (G-12). The receiver
# verifies X-Naso-Signature-256 against it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
NASO_WEBHOOK_SIGNING_SECRET=CHANGE_ME

# Optional handoff to a fabgpt-sec instance (backend/app/api/endpoints/sec.py).
# FABGPTSEC_SOAR_URL=
# NASO_SOAR_HMAC_SECRET=

# ══ SMTP / notifications ═════════════════════════════════════════════════════
# A `naso.local` SMTP_HOST puts notifications into dry-run mode: they are
# logged instead of sent. Point SMTP_HOST at a real server to actually deliver.
SMTP_HOST=smtp.naso.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=naso-engine@naso.example.com
ENABLE_NOTIFICATIONS=true
# Force dry-run regardless of SMTP_HOST.
# NASO_DRY_RUN=0

# ══ Forensic report signing ══════════════════════════════════════════════════
# Absolute path to the RSA PEM private key used to sign forensic dossiers.
# WARNING: the file MUST be 0o400 (owner read only) or signing is refused —
# looser permissions undermine the evidential value of the output.
#   chmod 400 /path/to/naso_forensic_signing.pem
NASO_PRIVATE_KEY_PATH=/run/secrets/naso_forensic_signing.pem
