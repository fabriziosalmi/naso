# NASO Forensic Engine — Environment Variables Reference
# Copia questo file in `.env` e compila TUTTI i valori prima del deploy.
# NON committare mai il file `.env` — è già in .gitignore.

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=naso_admin
DB_PASSWORD=CHANGE_ME
DB_NAME=naso_db
DATABASE_URL=postgresql+asyncpg://naso_admin:CHANGE_ME@db:5432/naso_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ── JWT Auth (EdDSA) ──────────────────────────────────────────────────────────
# JWT_PRIVATE_KEY and JWT_PUBLIC_KEY are NOT set here on purpose: pydantic
# Settings(secrets_dir="/run/secrets") loads them from files whose name
# equals the variable name (.secrets-mock/JWT_PRIVATE_KEY etc.). The
# files are populated by `make bootstrap` (or `python cli/generate_secrets.py`).
# Setting them as empty strings here would shadow the secrets_dir lookup.
ALGORITHM=EdDSA
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cookie sicuro (impostare a true in produzione con HTTPS)
NASO_COOKIE_SECURE=false

# ── Redis (JWT Blacklist) ─────────────────────────────────────────────────────
REDIS_HOST=redis://naso-cache:6379/0

# ── Elasticsearch ─────────────────────────────────────────────────────────────
# ELASTIC_PASSWORD usato da docker-compose, ES_PASSWORD da config.py
ELASTIC_PASSWORD=CHANGE_ME
ES_PASSWORD=CHANGE_ME
ES_HOST=elasticsearch
ES_PORT=9200
ES_USER=elastic

# ── RabbitMQ (Celery Broker) ──────────────────────────────────────────────────
# OBBLIGATORI — il sistema non si avvierà senza questi valori
RABBIT_USER=naso_broker_admin
RABBIT_PASSWORD=CHANGE_ME
RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=naso_broker_admin
RABBITMQ_PASS=CHANGE_ME

# ── MinIO (Object Storage — Screenshot, PDF) ──────────────────────────────────
# OBBLIGATORI — il sistema non si avvierà senza questi valori
MINIO_ROOT_USER=naso_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=naso_storage_admin
MINIO_SECRET_KEY=CHANGE_ME
MINIO_SECURE=false

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── TrustedHost ──────────────────────────────────────────────────────────────
# Comma-separated hosts the API answers to. Anything else hits a 400 from
# Starlette's TrustedHostMiddleware. Override in production with the public
# DNS name(s) — e.g. ALLOWED_HOSTS=naso.example.com,api.naso.example.com.
# The dev defaults already cover localhost + docker + the pytest httpx
# transport hostnames; setting this here is only needed when adding
# extra entries (a reverse proxy host, a staging name, etc.).
# ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal,naso-api

# ── Sentry (Opzionale) ───────────────────────────────────────────────────────
# Lasciare vuoto per disabilitare Sentry completamente
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
ENVIRONMENT=production

# ── OpenTelemetry (Jaeger) ────────────────────────────────────────────────────
OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# ── AI Co-Analyst (LM Studio / Ollama) ───────────────────────────────────────
# In Docker usa host.docker.internal:1234, in locale usa localhost:1234
AI_ENDPOINT=http://host.docker.internal:1234/v1
AI_MODEL=gemma-4-e2b-it
AI_ENABLE_THINKING=false

# ── Shodan OSINT ─────────────────────────────────────────────────────────────
SHODAN_API_KEY=

# ── GitHub Intelligence ───────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Telegram Intelligence ────────────────────────────────────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=naso_forensic_bot

# ── SMTP / Notifiche ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.naso.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=naso-engine@naso.local
ENABLE_NOTIFICATIONS=true

# ── Webhook Signing (Outgoing Alerts) ─────────────────────────────────────────
# Segreto HMAC-SHA256 per firmare gli alert verso Slack/Discord/Teams (G-12).
# Il ricevitore verifica X-Naso-Signature-256 con questo segreto.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
NASO_WEBHOOK_SIGNING_SECRET=CHANGE_ME

# ── Report Forense — Firma Digitale ──────────────────────────────────────────
# Path assoluto alla chiave privata RSA PEM per firmare i dossier forensi.
# ATTENZIONE: il file DEVE avere permessi 0o400 (solo proprietario in lettura).
# chmod 400 /path/to/naso_forensic_signing.pem
NASO_PRIVATE_KEY_PATH=/run/secrets/naso_forensic_signing.pem

# ── Tor / Dark Web Proxy ──────────────────────────────────────────────────────
TOR_PROXY=socks5h://naso-tor-lb:8118
