# NASO Environment Configuration
# Copy this file to .env and fill in your values.

# PostgreSQL
DB_USER=naso_admin
DB_PASSWORD=CHANGE_ME
DB_NAME=naso_db
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@db:5432/${DB_NAME}

# Elasticsearch
ELASTIC_PASSWORD=CHANGE_ME

# RabbitMQ
RABBIT_USER=naso_broker_admin
RABBIT_PASSWORD=CHANGE_ME

# MinIO Object Storage
MINIO_ROOT_USER=naso_storage_admin
MINIO_ROOT_PASSWORD=CHANGE_ME

# OpenTelemetry (Jaeger)
OTLP_ENDPOINT=http://host.docker.internal:4318/v1/traces

# Local AI (LM Studio / Ollama)
AI_ENDPOINT=http://host.docker.internal:1234/v1
AI_MODEL=gemma-4-e2b-it

# JWT Secret (generate a strong random string)
SECRET_KEY=CHANGE_ME

# SMTP (optional)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=naso@example.com

# Telegram Intelligence (optional)
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
