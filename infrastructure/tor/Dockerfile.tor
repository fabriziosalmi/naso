FROM alpine:3.24

# Fetched over HTTPS. An earlier revision rewrote the repository URLs to plain
# http "to avoid TLS issues during build in some environments" — the same trade
# the pip `--trusted-host` flags made in the application images, removed for the
# same reason: this is the channel that installs the software being run.
RUN apk add --no-cache tor curl

# ── Tor control-port authentication ─────────────────────────────────────────
# NEWNYM circuit rotation requires an authenticated control channel. We
# compute a ``HashedControlPassword`` at build time from the build arg so
# the plaintext never lands in an image layer and each deployment can set
# its own password without a custom Dockerfile.
#
# Default ``naso-dev`` matches the worker's
# ``NASO_DARKWEB_TOR_CONTROL_PASSWORD`` default — override both in
# production via:
#     --build-arg TOR_CONTROL_PASSWORD=<strong-pw>
#     and env var NASO_DARKWEB_TOR_CONTROL_PASSWORD=<strong-pw>
ARG TOR_CONTROL_PASSWORD=naso-dev

RUN set -eu; \
    TOR_PW_HASH="$(tor --hash-password "${TOR_CONTROL_PASSWORD}" | tail -1)"; \
    { \
        echo "SocksPort 0.0.0.0:9050"; \
        echo "ControlPort 0.0.0.0:9051"; \
        echo "DataDirectory /var/lib/tor"; \
        echo "DnsPort 5353"; \
        echo "AutomapHostsOnResolve 1"; \
        echo "StrictNodes 0"; \
        echo "ExcludeExitNodes {ua},{ru},{by},{ir},{cn}"; \
        # Cookie auth is disabled intentionally — the cluster is 5+ Tor
        # instances and sharing a cookie file via Docker volume would
        # couple them unnecessarily. Password auth is per-instance and
        # works over the internal ``naso-net`` bridge.
        echo "CookieAuthentication 0"; \
        echo "HashedControlPassword ${TOR_PW_HASH}"; \
    } > /etc/tor/torrc

EXPOSE 9050 9051

# ── Run as the package's own user, not root ─────────────────────────────────
# `apk add tor` creates the `tor` user and gives it /var/lib/tor. Tor refuses
# to use a DataDirectory owned by somebody else, so running the default root
# CMD produced a container that never started and, with `restart: always`,
# restarted forever:
#
#   [warn] /var/lib/tor is not owned by this user (root, 0) but by tor (100).
#   [warn] Failed to parse/validate config: Couldn't create private data
#          directory "/var/lib/tor"
#   [err]  Reading config failed--see warnings above.
#
# All five instances were in that loop, which took the haproxy front end down
# with them — see haproxy.cfg. Both ports are above 1024, so nothing here needs
# privileges. This also matches the non-root application images.
USER tor

CMD ["tor"]
