FROM python:3.11-slim

# Non-root user. The name is `pwuser` to match the account Playwright's own
# images use, and because docker-compose.yml already mounts a tmpfs at
# /home/pwuser/.cache for it. uid 10001 matches Dockerfile.backend.
ARG UID=10001
RUN groupadd --system --gid ${UID} pwuser \
 && useradd --system --uid ${UID} --gid pwuser --create-home --home /home/pwuser --shell /sbin/nologin pwuser

WORKDIR /app

# Playwright and browser dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    yara \
    wget \
    gnupg \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Dependencies are installed as root: pip needs write access to site-packages.
# The --trusted-host flags that used to be here are gone on purpose — they
# disable certificate verification for PyPI, which is not a trade this project
# should be making.
COPY workers/requirements.txt ./requirements.txt
COPY shared/requirements-shared.txt ./shared/requirements-shared.txt
RUN pip install --no-cache-dir -r requirements.txt

# Same two base-image advisories the API image carries -- CVE-2026-24049 in
# wheel, CVE-2026-23949 in jaraco.context. Neither is an application
# dependency; both arrive with the build toolchain. See the equivalent note in
# Dockerfile.backend.
RUN pip install --no-cache-dir --upgrade \
        pip setuptools "wheel>=0.46.2" "jaraco.context>=6.1.0"

# Browsers go to an explicit shared location rather than the default
# ~/.cache/ms-playwright. Two reasons: `playwright install` has to run as root
# (--with-deps calls apt-get), so the default would put them under /root where
# pwuser cannot read them; and /home/pwuser/.cache is a tmpfs at runtime, so
# anything installed there at build time is masked the moment the container
# starts.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright
RUN mkdir -p ${PLAYWRIGHT_BROWSERS_PATH} \
 && playwright install chromium firefox --with-deps \
 && chown -R pwuser:pwuser ${PLAYWRIGHT_BROWSERS_PATH}

COPY workers/ ./workers/
COPY shared/ ./shared/
RUN chown -R pwuser:pwuser /app

# Chromium wants a home directory it can write to. The root filesystem is
# read_only in docker-compose.yml, so only the /home/pwuser/.cache tmpfs is
# actually writable — which is where Playwright and Chromium put their
# scratch state — plus /tmp.
ENV HOME=/home/pwuser
USER pwuser:pwuser

CMD ["celery", "-A", "shared.celery_app", "worker", "--loglevel=info"]
